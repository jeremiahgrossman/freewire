# ---- macOS ----
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Xcode ----
DerivedData/
build/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- Swift Package Manager ----
.build/
.swiftpm/
Package.resolved

# ---- Go ----
# Compiled binaries (source lives in cmd/, binaries do not)
server/freewire-server
server/freewire-server-*
tunnel/freewire-tunnel
tunnel/freewire-tunnel-*
tunnel/freewire-tokens
tunnel/freewire-tokens-*
*.exe
*.test
*.out
vendor/

# ---- Signing, certs, keys — never commit ----
*.p12
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env
.env.*
secrets.json
# WireGuard configs contain private keys
*.conf.local
wg*.conf
# Server runtime config — holds the server WireGuard private key
server/freewire-server.json
server/*.state.json
# Docker runtime volume — holds the generated server WireGuard private key
server/data/
# Let's Encrypt certificate cache
server/acme-cache/

# ---- AWS / deploy local state ----
.terraform/
*.tfstate
*.tfstate.*
aws-credentials

# ---- Python (test harness) ----
__pycache__/
*.py[cod]

# ---- Editor / tooling ----
# Machine-local Claude permissions; .claude/settings.json (shared) is tracked
.claude/settings.local.json
.vscode/
.idea/
*.swp
*~

# Belt and braces for the "--help minted a keypair" bug: freewire-server used to
# treat any argument as a config path, and config.Load CREATES a missing path
# with a fresh WireGuard private key. Fixed in main.go's parseArgs, but an older
# binary lying around can still do it, and this must never be committed again.
server/--help
