# ---- Signing, certs, keys — never commit ----
*.p12
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env
.env.*
secrets.json
# WireGuard configs contain private keys
*.conf.local
wg*.conf
# Server runtime config — holds the server WireGuard private key
server/freewire-server.json
server/*.state.json

# ---- AWS / deploy local state ----
.terraform/
*.tfstate
*.tfstate.*
aws-credentials

