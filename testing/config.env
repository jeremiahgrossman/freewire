# Freewire captive portal test harness — environment
#
# Edit these to match your setup, then source or let the scripts load it.
# Every value here is read by both the macOS (pf) and Linux (iptables) scripts.

# ---- Freewire server under test ----
# The freewire-server container. OrbStack gives containers a routable address
# on a bridge interface, so pf filters this traffic the same way it filtered
# a remote host. Do NOT point the client at 127.0.0.1 for these runs: loopback
# traffic does not traverse the rules, so every config would silently pass.
#
# Find the current address with:
#   docker inspect freewire-server --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}'
SERVER_IP="52.203.246.145"

# The client fetches server config and registers its peer over the HTTP API
# BEFORE it selects a transport. In production that API rides HTTPS on 443
# alongside the TLS transport, so it is reachable whenever 443 is. The dev
# server splits it onto its own port, so each config must pass it explicitly
# or the client fails at bootstrap with CONN-3 and never reaches the fallback
# chain at all.
API_PORT="8080"

# The ICMP transport is icmp_udp: it rides UDP, not the ICMP protocol. Config 4
# has to pass this port or it blocks the path it exists to force.
ICMP_UDP_PORT="4500"

# Hostnames the client will reach for. Used by which-path.sh filters.
VPN_HOST="vpn.freewire.com"
TUNNEL_DOMAIN="tunnel.freewire.com"

# ---- Interfaces ----
# macOS: the interface carrying traffic toward SERVER_IP.
# For OrbStack this is the bridge serving the container subnet.
# Find it with:  route -n get "$SERVER_IP" | grep interface
UPLINK_IF="en0"

# Linux gateway only: uplink (to internet) and local (to test device).
LINUX_UPLINK_IF="en0"
LINUX_LOCAL_IF="eth1"

# ---- Gateway address ----
# macOS: the Mac's own address on UPLINK_IF (the CONNECT proxy binds here).
# Find it with:  ifconfig "$UPLINK_IF" | awk '/inet /{print $2}'
GATEWAY_IP="192.168.97.1"

# ---- Safety ----
# Seconds before rules auto-revert if you do not confirm. Prevents lockout
# if a rule is wrong. Set to 0 to disable (not recommended).
AUTO_REVERT_SECONDS=300
